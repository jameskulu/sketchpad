---
import Icon from "./Icon.astro";
import { TOOL_DISPLAY_ORDER, TOOL_ROUTES } from "../i18n/tool-content-types";
import { toolUiFor } from "../i18n/tool-ui";
import { uiFor } from "../i18n/ui";
import { deriveLocaleHref, type Locale } from "../i18n/locales";

interface Props {
  locale: Locale;
  /** current page route (e.g. "/" or "/whiteboard") to highlight */
  route: string;
}

const { locale, route } = Astro.props;
const ui = uiFor(locale);
const toolUi = toolUiFor(locale);

const items = TOOL_DISPLAY_ORDER.map((key) => ({
  href: deriveLocaleHref(locale, TOOL_ROUTES[key]),
  label: toolUi.boardNav.short[key],
  current: route === TOOL_ROUTES[key],
}));

const home = {
  href: deriveLocaleHref(locale, "/"),
  label: ui.siteName,
  current: route === "/",
};
---

<div id="board-nav" class="relative shrink-0">
  <button
    id="board-nav-trigger"
    type="button"
    class="flex h-8 items-center gap-1.5 whitespace-nowrap rounded-full border border-hairline px-2.5 text-[12px] font-medium text-ink-secondary transition-colors hover:bg-canvas-soft hover:text-ink max-sm:h-7 max-sm:px-2"
    aria-haspopup="true"
    aria-expanded="false"
    aria-label={toolUi.boardNav.menuAria}
    title={toolUi.boardNav.menuAria}
  >
    <Icon name="squares" class="size-4 shrink-0" />
    <span class="hidden sm:inline">{toolUi.boardNav.boards}</span>
    <svg
      id="board-nav-chevron"
      width="12"
      height="12"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="m6 9 6 6 6-6" />
    </svg>
  </button>

  <div
    id="board-nav-menu"
    role="menu"
    hidden
    class="absolute right-0 top-full z-50 mt-1.5 w-60 rounded-xl border border-hairline bg-white p-1.5 shadow-xl shadow-shadow-blue/10"
  >
    <a
      href={home.href}
      role="menuitem"
      aria-current={home.current ? "page" : undefined}
      class:list={[
        "flex items-center gap-2.5 rounded-lg px-3 py-2 text-[13px] font-medium transition-colors",
        home.current ? "bg-canvas-soft text-ink" : "text-ink-secondary hover:bg-canvas-soft hover:text-ink",
      ]}
    >
      <Icon name="brush" class="size-4 shrink-0 text-ink-mute" />
      <span class="flex-1 truncate">{home.label}</span>
      {home.current && <Icon name="check" class="size-4 shrink-0 text-primary" />}
    </a>

    <div class="mx-2 my-1 h-px bg-hairline" role="separator"></div>

    {items.map((item) => (
      <a
        href={item.href}
        role="menuitem"
        aria-current={item.current ? "page" : undefined}
        class:list={[
          "flex items-center gap-2.5 rounded-lg px-3 py-2 text-[13px] font-medium transition-colors",
          item.current ? "bg-canvas-soft text-ink" : "text-ink-secondary hover:bg-canvas-soft hover:text-ink",
        ]}
      >
        <Icon name="squares" class="size-4 shrink-0 text-ink-mute" />
        <span class="flex-1 truncate">{item.label}</span>
        {item.current && <Icon name="check" class="size-4 shrink-0 text-primary" />}
      </a>
    ))}
  </div>
</div>

<script>
  const root = document.getElementById("board-nav");
  const trigger = document.getElementById("board-nav-trigger") as HTMLButtonElement | null;
  const menu = document.getElementById("board-nav-menu") as HTMLElement | null;
  const chevron = document.getElementById("board-nav-chevron");
  if (root && trigger && menu) {
    const close = (): void => {
      menu.hidden = true;
      trigger.setAttribute("aria-expanded", "false");
      chevron?.setAttribute("style", "");
    };
    trigger.addEventListener("click", (e) => {
      e.stopPropagation();
      if (menu.hidden) {
        menu.hidden = false;
        trigger.setAttribute("aria-expanded", "true");
        chevron?.setAttribute("style", "transform: rotate(180deg)");
      } else {
        close();
      }
    });
    document.addEventListener("click", (e) => {
      if (!root.contains(e.target as Node)) close();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") close();
    });
  }
</script>