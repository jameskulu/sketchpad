---
import Prose from "./Prose.astro";
import ToolLinks from "./ToolLinks.astro";
import type { PageContent } from "../i18n/content-types";
import { DEFAULT_LOCALE, type Locale } from "../i18n/locales";
import { sortedPosts } from "../i18n/blog";

interface Props {
  locale: Locale;
  home: PageContent["home"];
}

const { locale, home } = Astro.props;

const h2 = "mt-12 text-xl font-semibold tracking-tight text-ink";
const p = "mt-4 text-[16px] leading-8 text-ink-secondary";
const faqQ = "text-[16px] font-semibold text-ink";
const faqA = "mt-2 text-[15px] leading-7 text-ink-secondary";
---

<section class="border-t border-hairline bg-white" aria-label="About the sketchpad">
  <div class="mx-auto w-full max-w-3xl px-4 py-14 sm:px-6 sm:py-20">
    <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">{home.h1}</h1>

    {home.intro.map((para) => (
      <p class="mt-6 text-[17px] leading-8 text-ink-secondary"><Prose text={para} /></p>
    ))}

    <h2 class={h2}>{home.toolsHeading}</h2>
    {home.tools.map((para) => <p class={p}><Prose text={para} /></p>)}

    <h2 class={h2}>{home.rankingHeading}</h2>
    {home.ranking.map((para) => <p class={p}><Prose text={para} /></p>)}

    <h2 class={h2}>{home.kidsHeading}</h2>
    {home.kids.map((para) => <p class={p}><Prose text={para} /></p>)}

    <h2 class={h2}>{home.faqHeading}</h2>
    <div class="mt-4 divide-y divide-hairline">
      {home.faq.map((item) => (
        <div class="py-4">
          <h3 class={faqQ}>{item.q}</h3>
          <p class={faqA}><Prose text={item.a} /></p>
        </div>
      ))}
    </div>

    {home.closing.map((para) => (
      <p class="mt-10 text-[16px] leading-8 text-ink-secondary"><Prose text={para} /></p>
    ))}

    <ToolLinks locale={locale} heading={home.toolLinksHeading} />

    {locale === DEFAULT_LOCALE && (
      <div class="mt-12 border-t border-hairline pt-10">
        <h2 class="text-xl font-semibold tracking-tight text-ink">Drawing guides on the blog</h2>
        <p class={p}>
          Practical tips, tutorials, and product notes for getting more from your sketchpad.
        </p>
        <div class="mt-4 grid gap-3 sm:grid-cols-2">
          {sortedPosts().slice(0, 4).map((post) => (
            <a
              href={`/blog/${post.slug}/`}
              class="group block rounded-xl border border-hairline bg-white p-4 transition-colors hover:border-primary/40 hover:shadow-md"
            >
              <span class="text-[11px] font-medium uppercase tracking-wide text-primary">{post.category}</span>
              <span class="mt-1 block font-semibold text-ink">{post.title}</span>
              <span class="mt-1 block text-[13px] leading-6 text-ink-mute">{post.excerpt}</span>
            </a>
          ))}
        </div>
        <a href="/blog/" class="mt-5 inline-block text-[13px] font-medium text-primary hover:underline">
          Read the blog →
        </a>
      </div>
    )}
  </div>
</section>
