---
interface Props {
  name: string;
  class?: string;
}
const { name, class: className } = Astro.props;
---
<svg
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className ?? ""}
>
  {name === "brush" && <path d="M9 3l7.5 7.5L8 19l-5 2 2-5 8.5-8.5M14 7l3-3 2 2-3 3" />}
  {
    name === "select" && (
      <>
        <path d="M4 4l6 17 2.5-6.5L19 12 4 4Z" />
        <path d="M12.5 14.5 19 21" />
      </>
    )
  }
  {name === "pencil" && (
    <>
      <path d="M4 20l1-4L16.9 4.1a1.7 1.7 0 0 1 2.4 0l.6.6a1.7 1.7 0 0 1 0 2.4L8 18.6 4 20Z" />
      <path d="M14 7l3 3" />
    </>
  )}
  {name === "rect" && <rect x="3.5" y="5.5" width="17" height="13" rx="1.5" />}
  {name === "ellipse" && <ellipse cx="12" cy="12" rx="8.5" ry="6.5" />}
  {name === "triangle" && <path d="M12 4.5 20.5 19h-17Z" />}
  {name === "line" && <path d="M4.5 19.5 19.5 4.5" />}
  {name === "arrow" && <path d="M6 18 18 6M8.5 6H18v9.5" />}
  {
    name === "text" && (
      <>
        <path d="M5 6V4h14v2" />
        <path d="M12 4v16" />
        <path d="M9 20h6" />
      </>
    )
  }
  {
    name === "eraser" && (
      <>
        <path d="M9 4.5 19.5 15a1.8 1.8 0 0 1 0 2.5l-2 2a1.8 1.8 0 0 1-2.5 0L4.5 9a1.8 1.8 0 0 1 0-2.5l2-2A1.8 1.8 0 0 1 9 4.5Z" />
        <path d="M13 9l2 2" />
      </>
    )
  }
  {
    name === "highlighter" && (
      <>
        <path d="M9 3.5 20.5 15a1.8 1.8 0 0 1 0 2.5l-2 2a1.8 1.8 0 0 1-2.5 0L4.5 8a1.8 1.8 0 0 1 0-2.5l2-2A1.8 1.8 0 0 1 9 3.5Z" />
        <path d="M8 4l6 5.5 5.5 6M4 20l5-1.5" />
      </>
    )
  }
  {
    name === "sticky" && (
      <>
        <path d="M5 3.5h10l5 5v12h-15Z" />
        <path d="M15 3.5v5h5" />
        <path d="M8 12h8M8 15.5h8" />
      </>
    )
  }
  {
    name === "undo" && (
      <>
        <path d="M4 9h10a6 6 0 0 1 0 12h-3" />
        <path d="M8 5 4 9l4 4" />
      </>
    )
  }
  {
    name === "redo" && (
      <>
        <path d="M20 9H10a6 6 0 0 0 0 12h3" />
        <path d="M16 5l4 4-4 4" />
      </>
    )
  }
  {
    name === "grid" && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="2" />
        <path d="M3 9h18M3 15h18M9 3v18M15 3v18" />
      </>
    )
  }
  {
    name === "trash" && (
      <>
        <path d="M4.5 7h15" />
        <path d="M9.5 7V4.5h5V7" />
        <path d="M6.5 7 7 20.5h10L17.5 7" />
        <path d="M10 11v5M14 11v5" />
      </>
    )
  }
  {
    name === "delete" && (
      <>
        <rect x="4" y="4" width="16" height="16" rx="2.5" />
        <path d="M9.5 9.5l5 5M14.5 9.5l-5 5" />
      </>
    )
  }
  {name === "maximize" && <path d="M8.5 3.5H3.5v5M15.5 3.5h5v5M8.5 20.5h-5v-5M15.5 20.5h5v-5" />}
  {name === "minimize" && <path d="M3.5 8.5H8.5v-5M15.5 3.5v5h5M3.5 15.5h5v5M20.5 15.5h-5v5" />}
  {
    name === "download" && (
      <>
        <path d="M12 3v11" />
        <path d="M7 10l5 5 5-5" />
        <path d="M4 19.5h16" />
      </>
    )
  }
  {name === "minus" && <path d="M5 12h14" />}
  {name === "plus" && <path d="M12 5v14M5 12h14" />}
  {name === "fit" && <path d="M4 8V5.5A1.5 1.5 0 0 1 5.5 4H8M20 8V5.5A1.5 1.5 0 0 0 18.5 4H16M4 16v2.5A1.5 1.5 0 0 0 5.5 20H8M20 16v2.5a1.5 1.5 0 0 1-1.5 1.5H16" />}
  {
    name === "check" && (
      <>
        <path d="m4.5 12.5 5 5 10-11" />
      </>
    )
  }
  {
    name === "squares" && (
      <>
        <rect x="3.5" y="3.5" width="7.5" height="7.5" rx="1.5" />
        <rect x="13" y="3.5" width="7.5" height="7.5" rx="1.5" />
        <rect x="3.5" y="13" width="7.5" height="7.5" rx="1.5" />
        <rect x="13" y="13" width="7.5" height="7.5" rx="1.5" />
      </>
    )
  }
  {
    name === "palette" && (
      <>
        <path d="M12 3a9 9 0 1 0 0 18c1.4 0 2.2-.9 2.2-2 0-.6-.3-1-.7-1.4-.4-.4-.6-.8-.6-1.4 0-1.1.9-2 2-2H17a4 4 0 0 0 4-4c0-4.2-4-7.2-9-7.2Z" />
        <path d="M7 13.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3ZM16.5 7.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3ZM10.5 6a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z" />
      </>
    )
  }
</svg>