---
import SiteShell from "./SiteShell.astro";
import { formatPostDate, sortedPosts } from "../i18n/blog";
import { DEFAULT_LOCALE } from "../i18n/locales";
import { SITE } from "../lib/site";

const posts = sortedPosts();
const description =
  "Practical drawing guides, sketchpad tutorials, and product notes from Simple Sketchpad. Learn to sketch, diagram, and create on a free browser canvas.";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "Simple Sketchpad Blog",
  description,
  url: new URL("/blog/", SITE.url).href,
  blogPost: posts.map((post) => ({
    "@type": "BlogPosting",
    headline: post.title,
    description: post.description,
    datePublished: post.date,
    url: new URL(`/blog/${post.slug}/`, SITE.url).href,
  })),
};
---

<SiteShell
  title="Blog"
  description={description}
  locale={DEFAULT_LOCALE}
  route="/blog"
  structuredData={structuredData}
  localized={false}
  showLangSwitcher={false}
>
  <header class="border-b border-hairline pb-8">
    <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-primary">Blog</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight text-ink sm:text-4xl">Drawing guides & product notes</h1>
    <p class="mt-4 text-[16px] leading-8 text-ink-secondary">
      Short, practical articles about sketching, diagramming, and getting the most out of a free online
      sketchpad. No fluff — just workflows you can try in your next drawing session.
    </p>
    <a
      href="/"
      class="mt-6 inline-flex items-center gap-1.5 rounded-full bg-primary px-4 py-2 text-[13px] font-medium text-white transition-colors hover:bg-primary-deep"
    >
      Open the sketchpad
      <span aria-hidden="true">→</span>
    </a>
  </header>

  <div class="mt-10 space-y-4">
    {posts.map((post) => (
      <article class="group relative rounded-xl border border-hairline bg-white p-5 transition-colors focus-within:border-primary/50 hover:border-primary/40 hover:shadow-md sm:p-6">
        <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-[11px] font-medium uppercase tracking-wide text-ink-mute">
          <span class="text-primary">{post.category}</span>
          <span aria-hidden="true">·</span>
          <time datetime={post.date}>{formatPostDate(post.date)}</time>
          <span aria-hidden="true">·</span>
          <span>{post.readingTime} min read</span>
        </div>
        <h2 class="mt-3 text-lg font-semibold tracking-tight text-ink sm:text-xl">
          <a href={`/blog/${post.slug}/`} class="after:absolute after:inset-0 focus:outline-none">
            {post.title}
          </a>
        </h2>
        <p class="mt-2 text-[14px] leading-7 text-ink-secondary">{post.excerpt}</p>
        <span class="mt-3 inline-flex items-center gap-1 text-[13px] font-medium text-primary">
          Read article
          <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
        </span>
      </article>
    ))}
  </div>
</SiteShell>
