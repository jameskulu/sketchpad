---
import Layout from "../layouts/Layout.astro";
import Icon from "./Icon.astro";
import ToolSeo from "./ToolSeo.astro";
import ToolHeader from "./ToolHeader.astro";
import { SITE } from "../lib/site";
import { uiFor } from "../i18n/ui";
import { toolUiFor } from "../i18n/tool-ui";
import type { ToolPageContent, ToolPageKey } from "../i18n/tool-content-types";
import { deriveLocaleHref, type Locale } from "../i18n/locales";

interface Props {
  locale: Locale;
  pageKey: ToolPageKey;
  content: ToolPageContent;
}

const { locale, pageKey, content } = Astro.props;
const ui = uiFor(locale);
const toolUi = toolUiFor(locale);

const route = "/kids-drawing";

const colors = ["#ea2261", "#ff9d00", "#ffd400", "#0e9f6e", "#0ea5e9", "#533afd", "#8b5cf6", "#000000", "#ffffff"];
const stamps = [
  "⭐", "❤️", "🌈", "🦄", "🚀", "🐱", "🐶", "🦁", "🦖", "🌸", "☀️", "🍄",
  "🍦", "🍕", "🎈", "👑", "🔥", "🎉", "🚗", "✈️", "🍀", "👾", "🎨", "💎",
];

const seoData = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: content.h1,
  url: new URL(deriveLocaleHref(locale, route), SITE.url).href,
  description: content.seoDescription,
  applicationCategory: "GameApplication",
  operatingSystem: "Any",
  browserRequirements: "Requires JavaScript. Works on desktop, tablet, and mobile browsers.",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  featureList: [
    "Free — no account or sign-up required",
    "Big buttons that are easy to tap",
    "Emoji stamps and stickers",
    "Customizable size for brush, pen, stamps, and eraser",
    "Select and move drawings and stamps",
    "Autosave in the browser",
    "Safe for kids — no chat, comments, or sign-up",
  ],
  isAccessibleForFree: true,
  audience: { "@type": "Audience", audienceType: "Children" },
};

const faqData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: content.faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<Layout
  title={content.seoTitle}
  description={content.seoDescription}
  structuredData={[seoData, faqData]}
  locale={locale}
  route={route}
>
  <div id="app" class="flex h-dvh flex-col" data-lang={locale}>
    <!-- Top bar -->
    <ToolHeader locale={locale} route="/kids-drawing" />

    <!-- Canvas -->
    <main id="stage" class="relative min-h-0 flex-1 touch-none select-none overflow-hidden bg-canvas">
      <canvas id="sketchpad-canvas" class="block h-full w-full cursor-crosshair" aria-label={ui.canvas.drawingTools}></canvas>
      <button
        id="delete-btn"
        class="float-del absolute z-10 grid size-10 place-items-center rounded-xl border border-hairline bg-white dark:bg-[#262626] text-ink-mute shadow-lg transition-transform hover:scale-110 active:scale-95"
        aria-label={ui.canvas.deleteSelection}
        title={ui.canvas.deleteSelection}
        hidden
      >
        <Icon name="trash" class="size-5 text-red-500" />
      </button>

      <!-- Floating Follow Pill -->
      <div id="follow-pill" class="follow-pill" hidden role="status" aria-live="polite">
        <span id="follow-pill-dot" class="follow-pill-dot"></span>
        <span id="follow-pill-text">{ui.collab.following}</span>
        <button id="follow-stop-btn" type="button" class="follow-stop-btn" aria-label={ui.collab.stopFollowing}>✕ {ui.collab.stopFollowing}</button>
      </div>
    </main>

    <!-- Control shelf -->
    <section id="kids-shelf" class="kids-control-shelf z-20 shrink-0 border-t border-hairline bg-white/95 dark:bg-[#161616]/95 px-3 py-2.5 backdrop-blur sm:px-5">
      <div class="grid grid-cols-1 gap-2.5 lg:grid-cols-12 lg:items-center">
        <!-- Palette & Rainbow Swatches (lg: 5 cols) -->
        <div class="lg:col-span-5 min-w-0">
          <p class="kids-label">{toolUi.kids.paletteHeading}</p>
          <div class="mt-1 flex items-center gap-1.5 overflow-x-auto no-scrollbar py-0.5" id="swatches">
            <!-- Magic Rainbow button -->
            <button
              type="button"
              id="rainbow-swatch"
              class="rainbow-btn relative flex size-9 shrink-0 items-center justify-center rounded-full shadow-xs ring-1 ring-inset ring-black/10 transition-transform hover:scale-110 active:scale-95"
              data-color="rainbow"
              aria-label="Magic Rainbow Pen"
              title="Magic Rainbow Pen"
              style="background: linear-gradient(135deg, #ff4e50, #f9d423, #00e676, #00b0ff, #d500f9);"
            >
              <span class="text-base select-none pointer-events-none">🌈</span>
            </button>
            {colors.map((c) => (
              <button
                type="button"
                class="swatch size-9 shrink-0 rounded-full ring-1 ring-inset ring-black/10 transition-transform hover:scale-110 active:scale-95"
                style={`background:${c}`}
                data-color={c}
                aria-label={`${ui.canvas.color} ${c}`}
              ></button>
            ))}
            <!-- Custom color picker -->
            <label
              class="relative flex size-9 shrink-0 cursor-pointer items-center justify-center rounded-full border-2 border-dashed border-hairline bg-canvas-soft text-ink-secondary transition-transform hover:scale-110 hover:border-primary hover:text-primary"
              title={ui.canvas.pickCustomColor}
            >
              <input id="color-input" type="color" value="#ea2261" class="absolute inset-0 size-full cursor-pointer opacity-0" aria-label={ui.canvas.pickCustomColor} />
              <span class="text-base font-bold leading-none select-none">+</span>
            </label>
          </div>
        </div>

        <!-- Size Controls: Presets + Slider (lg: 4 cols) -->
        <div class="lg:col-span-4 min-w-0 border-t border-hairline pt-2 lg:border-t-0 lg:border-l lg:pl-4 lg:pt-0">
          <div class="flex items-center justify-between">
            <p class="kids-label" id="size-title">{ui.canvas.stroke}</p>
            <span id="size-label" class="text-[12px] font-bold tabular-nums text-primary">18 {ui.canvas.px}</span>
          </div>
          <div class="mt-1 flex items-center gap-2">
            <!-- Quick Size Presets (S, M, L, XL) -->
            <div class="flex items-center gap-1 shrink-0" id="size-presets">
              <button type="button" class="size-preset-btn flex size-8 items-center justify-center rounded-xl border border-hairline bg-white dark:bg-[#242424] dark:border-[#383838] transition-all hover:bg-canvas-soft dark:hover:bg-[#303030]" data-preset="small" aria-label="Small size" title="Small">
                <span class="size-dot size-1.5 rounded-full bg-ink dark:bg-[#f8fafc]"></span>
              </button>
              <button type="button" class="size-preset-btn flex size-8 items-center justify-center rounded-xl border border-hairline bg-white dark:bg-[#242424] dark:border-[#383838] transition-all hover:bg-canvas-soft dark:hover:bg-[#303030]" data-preset="medium" aria-label="Medium size" title="Medium">
                <span class="size-dot size-3 rounded-full bg-ink dark:bg-[#f8fafc]"></span>
              </button>
              <button type="button" class="size-preset-btn flex size-8 items-center justify-center rounded-xl border border-hairline bg-white dark:bg-[#242424] dark:border-[#383838] transition-all hover:bg-canvas-soft dark:hover:bg-[#303030] is-active" data-preset="large" aria-label="Large size" title="Large">
                <span class="size-dot size-4.5 rounded-full bg-ink dark:bg-[#f8fafc]"></span>
              </button>
              <button type="button" class="size-preset-btn flex size-8 items-center justify-center rounded-xl border border-hairline bg-white dark:bg-[#242424] dark:border-[#383838] transition-all hover:bg-canvas-soft dark:hover:bg-[#303030]" data-preset="xlarge" aria-label="Extra Large size" title="Extra Large">
                <span class="size-dot size-6 rounded-full bg-ink dark:bg-[#f8fafc]"></span>
              </button>
            </div>
            <!-- Range Slider (home-page sketchpad behavior) -->
            <input
              id="size-slider"
              type="range"
              min="1"
              max="96"
              value="18"
              class="h-2 flex-1 cursor-pointer accent-primary"
              aria-label={ui.canvas.strokeSizeAria}
            />
          </div>
        </div>

        <!-- Paper Canvas Themes (lg: 3 cols) -->
        <div class="lg:col-span-3 min-w-0 border-t border-hairline pt-2 lg:border-t-0 lg:border-l lg:pl-4 lg:pt-0">
          <p class="kids-label">Paper</p>
          <div class="mt-1 flex items-center gap-1.5 overflow-x-auto no-scrollbar py-0.5" id="paper-themes">
            <button type="button" class="paper-btn flex h-8 shrink-0 items-center gap-1 rounded-xl border border-hairline bg-white dark:bg-[#242424] dark:border-[#383838] px-2 text-xs font-semibold text-ink dark:text-[#f8fafc] transition-all hover:border-primary is-active" data-paper-bg="#ffffff" title="White Paper">
              <span class="size-3.5 rounded-full border border-hairline dark:border-white/20 bg-white"></span>
              <span>White</span>
            </button>
            <button type="button" class="paper-btn flex h-8 shrink-0 items-center gap-1 rounded-xl border border-hairline bg-[#fef9e7] dark:bg-[#2d281c] dark:border-[#4d4430] px-2 text-xs font-semibold text-ink dark:text-amber-100 transition-all hover:border-primary" data-paper-bg="#fef9e7" title="Butter Paper">
              <span class="size-3.5 rounded-full border border-hairline bg-[#fef9e7]"></span>
              <span>Butter</span>
            </button>
            <button type="button" class="paper-btn flex h-8 shrink-0 items-center gap-1 rounded-xl border border-hairline bg-[#f0f7ff] dark:bg-[#182635] dark:border-[#2a3c50] px-2 text-xs font-semibold text-ink dark:text-sky-100 transition-all hover:border-primary" data-paper-bg="#f0f7ff" title="Sky Paper">
              <span class="size-3.5 rounded-full border border-hairline bg-[#f0f7ff]"></span>
              <span>Sky</span>
            </button>
            <button type="button" class="paper-btn flex h-8 shrink-0 items-center gap-1 rounded-xl border border-hairline bg-[#232b2b] px-2 text-xs font-semibold text-white transition-all hover:border-primary" data-paper-bg="#232b2b" title="Blackboard">
              <span class="size-3.5 rounded-full border border-white/20 bg-[#232b2b]"></span>
              <span>Dark</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Stamps Horizontal Bar -->
      <div class="mt-2.5 border-t border-hairline pt-2">
        <div class="flex items-center justify-between">
          <p class="kids-label">{toolUi.kids.stampsHeading}</p>
          <span class="text-[11px] text-ink-mute hidden sm:inline">{toolUi.kids.stampHint}</span>
        </div>
        <div class="mt-1.5 flex gap-1.5 overflow-x-auto no-scrollbar py-0.5" id="stamps">
          {stamps.map((s) => (
            <button
              type="button"
              class="stamp-btn flex size-10 shrink-0 items-center justify-center rounded-2xl border border-hairline bg-canvas-soft/80 dark:bg-[#242424] dark:border-[#383838] text-2xl leading-none transition-transform hover:scale-115 active:scale-95"
              data-char={s}
              aria-pressed="false"
              aria-label={`${toolUi.kids.stampsHeading} ${s}`}
            >
              <span aria-hidden="true" class="select-none pointer-events-none">{s}</span>
            </button>
          ))}
        </div>
      </div>
    </section>

    <!-- Dock -->
    <footer id="kids-dock" class="kids-dock z-20 shrink-0 border-t border-hairline bg-white/95 dark:bg-[#161616]/95 px-3 py-2.5 backdrop-blur sm:px-5">
      <div class="flex items-center justify-between gap-2 overflow-x-auto no-scrollbar">
        <!-- Tools group -->
        <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
          <button
            id="tool-pencil"
            class="kids-action"
            aria-label={ui.tools.pencil}
            aria-pressed="false"
          >
            <Icon name="pencil" class="size-5" />
            <span class="hidden sm:inline">{ui.tools.pencil}</span>
          </button>
          <button
            id="tool-brush"
            class="kids-action is-active"
            aria-label={toolUi.kids.draw}
            aria-pressed="true"
          >
            <Icon name="brush" class="size-5" />
            <span class="hidden sm:inline">{toolUi.kids.draw}</span>
          </button>
          <button
            id="tool-stamp"
            class="kids-action"
            aria-label={toolUi.tools.stamp}
            aria-pressed="false"
          >
            <span class="text-base select-none pointer-events-none">⭐</span>
            <span class="hidden sm:inline">{toolUi.tools.stamp}</span>
          </button>
          <button
            id="tool-eraser"
            class="kids-action"
            aria-label={toolUi.kids.erase}
            aria-pressed="false"
          >
            <Icon name="eraser" class="size-5" />
            <span class="hidden sm:inline">{toolUi.kids.erase}</span>
          </button>
          <button
            id="tool-select"
            class="kids-action"
            aria-label={ui.tools.select}
            aria-pressed="false"
          >
            <Icon name="select" class="size-5" />
            <span class="hidden sm:inline">{ui.tools.select}</span>
          </button>
        </div>

        <div class="h-7 w-px bg-hairline shrink-0" role="separator"></div>

        <!-- Selection & History actions -->
        <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
          <button
            id="select-all-btn"
            class="kids-action square"
            aria-label="Select all drawings and stamps"
            title="Select all drawings and stamps (Ctrl+A)"
          >
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="2" stroke-dasharray="3 3" />
              <path d="M9 12l2 2 4-4" />
            </svg>
          </button>
          <button id="undo-btn" class="kids-action square" aria-label={toolUi.kids.undo} disabled>
            <Icon name="undo" class="size-5" />
          </button>
          <button id="redo-btn" class="kids-action square" aria-label={toolUi.kids.redo} disabled>
            <Icon name="redo" class="size-5" />
          </button>
        </div>

        <!-- End actions -->
        <div class="ml-auto flex items-center gap-1.5 sm:gap-2 shrink-0">
          <button id="clear-btn" class="kids-action" aria-label={toolUi.kids.clear}>
            <Icon name="trash" class="size-5" />
            <span class="hidden sm:inline">{toolUi.kids.clear}</span>
          </button>
          <button id="fullscreen-btn" class="kids-action square" data-state="off" aria-label={ui.canvas.toggleFullscreen} title={ui.canvas.toggleFullscreen}>
            <Icon name="maximize" class="size-5" />
            <Icon name="minimize" class="size-5" />
          </button>
        </div>
      </div>
    </footer>
  </div>

  <!-- Hidden controls required by the engine bindings -->
  <button id="grid-btn" hidden></button>
  <button id="zoom-out-btn" hidden></button>
  <button id="zoom-in-btn" hidden></button>
  <button id="zoom-fit-btn" hidden></button>
  <button id="zoom-100-btn" hidden></button>
  <button id="fullscreen-btn-mobile" hidden></button>
  <div id="opacity-slider" hidden></div>
  <div id="opacity-label" hidden></div>
  <div id="fill-toggle" hidden></div>
  <div id="zoom-label" hidden></div>
  <div id="coords-label" hidden></div>

  <ToolSeo locale={locale} pageKey={pageKey} content={content} />
</Layout>

<style>
  @reference "../styles/global.css";

  .kids-label {
    @apply text-[11px] font-semibold uppercase tracking-[0.08em] text-ink-mute;
  }
  .kids-action {
    @apply flex h-11 items-center gap-2 rounded-2xl px-3 sm:px-4 text-[14px] font-semibold transition-all active:scale-95 cursor-pointer;
  }
  .kids-action.square {
    @apply size-11 justify-center rounded-2xl border border-hairline bg-white dark:bg-[#242424] dark:border-[#383838] px-0 text-ink dark:text-[#f8fafc] hover:bg-canvas-soft dark:hover:bg-[#303030];
  }
  .kids-action:disabled {
    @apply pointer-events-none opacity-35;
  }
  .kids-action.is-active {
    @apply bg-primary text-white shadow-md ring-2 ring-primary/40 hover:bg-primary-deep;
  }
  .kids-action:not(.is-active) {
    @apply border border-hairline bg-white dark:bg-[#242424] dark:border-[#383838] text-ink dark:text-[#f8fafc] hover:bg-canvas-soft dark:hover:bg-[#303030];
  }
  .stamp-btn.is-active {
    @apply border-primary bg-primary/15 ring-2 ring-primary/40 shadow-xs scale-105;
  }
  .size-preset-btn.is-active {
    @apply border-primary bg-primary/10 text-primary ring-2 ring-primary/30;
  }
  .size-preset-btn.is-active .size-dot {
    @apply bg-primary;
  }
  .rainbow-btn.is-active, #rainbow-swatch.is-active {
    @apply ring-3 ring-primary shadow-md scale-110;
  }
  .paper-btn.is-active {
    @apply ring-2 ring-primary border-primary shadow-xs;
  }

  :global(html.dark) .kids-action.square,
  :global(html.dark) .kids-action:not(.is-active) {
    background-color: #242424;
    border-color: #383838;
    color: #f8fafc;
  }
  :global(html.dark) .kids-action.square:hover,
  :global(html.dark) .kids-action:not(.is-active):hover {
    background-color: #303030;
    color: #ffffff;
  }
  :global(html.dark) .size-preset-btn {
    background-color: #242424;
    border-color: #383838;
    color: #f8fafc;
  }
  :global(html.dark) .size-preset-btn .size-dot {
    background-color: #f8fafc;
  }
  :global(html.dark) .size-preset-btn.is-active {
    background-color: #312e81;
    border-color: #818cf8;
  }
  :global(html.dark) .size-preset-btn.is-active .size-dot {
    background-color: #818cf8;
  }
  :global(html.dark) .stamp-btn {
    background-color: #242424;
    border-color: #383838;
    color: #f8fafc;
  }
  :global(html.dark) .stamp-btn:hover {
    background-color: #303030;
  }
  :global(html.dark) .stamp-btn.is-active {
    background-color: #312e81;
    border-color: #818cf8;
  }
  :global(html.dark) .paper-btn {
    border-color: #383838;
    color: #f8fafc;
  }
</style>

<style is:global>
  .no-scrollbar {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  import { Sketchpad } from "../lib/sketchpad";
  import { uiFor } from "../i18n/ui";
  import { toolUiFor } from "../i18n/tool-ui";
  import type { ToolId } from "../lib/elements";
  import type { Locale } from "../i18n/locales";
  import { initThemeToggle } from "../lib/color-theme";
  import { initCollabUI } from "../lib/collab-ui";

  const rootEl = document.querySelector<HTMLElement>('[id="app"]');
  const canvas = document.getElementById("sketchpad-canvas");
  if (!(canvas instanceof HTMLCanvasElement)) {
    throw new Error("sketchpad canvas missing");
  }

  const appEl = rootEl as HTMLElement;
  const stage = document.getElementById("stage");
  if (!(stage instanceof HTMLElement)) {
    throw new Error("sketchpad stage missing");
  }

  const currentLocale = (appEl?.dataset.lang as Locale) ?? "en";
  const ui = uiFor(currentLocale);
  const toolUi = toolUiFor(currentLocale);

  const q = <T extends HTMLElement = HTMLElement>(id: string): T => {
    const el = document.getElementById(id);
    if (!el) throw new Error(`missing element: ${id}`);
    return el as T;
  };

  const toolButtons: Partial<Record<ToolId, HTMLButtonElement>> = {};
  document.querySelectorAll<HTMLButtonElement>("[id^='tool-']").forEach((btn) => {
    const id = btn.id.replace("tool-", "") as ToolId;
    toolButtons[id] = btn;
  });

  const swatches = document.querySelectorAll<HTMLElement>(".swatch");
  if (!swatches.length) throw new Error("missing swatches");

  const autosaveDot = q("autosave-dot");

  const sizePresets: Record<string, { small: number; medium: number; large: number; xlarge: number }> = {
    brush: { small: 6, medium: 14, large: 28, xlarge: 54 },
    pencil: { small: 3, medium: 8, large: 16, xlarge: 28 },
    eraser: { small: 12, medium: 28, large: 54, xlarge: 96 },
    stamp: { small: 36, medium: 64, large: 96, xlarge: 140 },
    select: { small: 24, medium: 48, large: 80, xlarge: 120 },
  };

  const getActiveToolName = (): string => {
    return (pad as any)?.tool || "brush";
  };

  const updateActiveSizePreset = () => {
    const curTool = getActiveToolName();
    const presets = sizePresets[curTool] ?? sizePresets.brush;
    const curSize = pad.getStrokeWidth();
    document.querySelectorAll<HTMLButtonElement>(".size-preset-btn").forEach((btn) => {
      const presetKey = btn.dataset.preset as "small" | "medium" | "large" | "xlarge";
      const targetSize = presets[presetKey];
      const isActive = typeof targetSize === "number" && Math.abs(curSize - targetSize) <= 4;
      btn.classList.toggle("is-active", isActive);
      btn.setAttribute("aria-pressed", String(isActive));
    });
  };

  const pad = new Sketchpad({
    stage,
    canvas,
    darkMode: document.documentElement.classList.contains("dark"),
    ui: {
      toolButtons,
      undoBtn: q<HTMLButtonElement>("undo-btn"),
      redoBtn: q<HTMLButtonElement>("redo-btn"),
      deleteBtn: q<HTMLButtonElement>("delete-btn"),
      zoomOutBtn: q<HTMLButtonElement>("zoom-out-btn"),
      zoomInBtn: q<HTMLButtonElement>("zoom-in-btn"),
      zoomFitBtn: q<HTMLButtonElement>("zoom-fit-btn"),
      zoom100Btn: q<HTMLButtonElement>("zoom-100-btn"),
      clearBtn: q<HTMLButtonElement>("clear-btn"),
      gridBtn: q<HTMLButtonElement>("grid-btn"),
      fullscreenBtn: q<HTMLButtonElement>("fullscreen-btn"),
      fullscreenBtnMobile: q<HTMLButtonElement>("fullscreen-btn-mobile"),
      downloadBtn: q<HTMLButtonElement>("download-btn"),
      downloadSvgBtn: q<HTMLButtonElement>("download-svg-btn"),
      swatches,
      colorInput: q<HTMLInputElement>("color-input"),
      sizeSlider: q<HTMLInputElement>("size-slider"),
      sizeLabel: q<HTMLElement>("size-label"),
      opacitySlider: q<HTMLInputElement>("opacity-slider"),
      opacityLabel: q<HTMLElement>("opacity-label"),
      fillToggle: q<HTMLButtonElement>("fill-toggle"),
      zoomLabel: q<HTMLElement>("zoom-label"),
      coordsLabel: q<HTMLElement>("coords-label"),
      autosaveLabel: q<HTMLElement>("autosave-label"),
      strings: {
        autosaveSaved: ui.canvas.autosaveSaved,
        autosaveSaving: ui.canvas.autosaveSaving,
        autosaveNotSaved: ui.canvas.autosaveNotSaved,
        px: ui.canvas.px,
        clearConfirmTitle: ui.canvas.clearConfirmTitle,
        clearConfirmBody: ui.canvas.clearConfirmBody,
        clearConfirmDelete: ui.canvas.clearConfirmDelete,
        clearConfirmCancel: ui.canvas.clearConfirmCancel,
        readOnlyBannerBadge: ui.collab.readOnlyBannerBadge,
        duplicateToEdit: ui.collab.duplicateToEdit,
      },
    },
    defaultTool: "brush",
    defaultColor: "#ea2261",
    defaultGridOn: false,
    defaultSizes: { brush: 18, pencil: 8, stamp: 72, eraser: 28 },
    autosaveKey: "simplesketchpad.kids-drawing.v1",
    onState: (s) => {
      q<HTMLButtonElement>("delete-btn").disabled = !s.hasSelection;
      autosaveDot.classList.toggle("bg-emerald-500", s.saved === "saved");
      autosaveDot.classList.toggle("bg-amber-400", s.saved === "saving");
      autosaveDot.classList.toggle("bg-[#ea2261]", s.saved === "dirty");
      updateActiveSizePreset();

      const sizeTitle = document.getElementById("size-title");
      if (sizeTitle) {
        sizeTitle.textContent =
          s.tool === "stamp"
            ? `${toolUi.kids.stampsHeading} ${ui.canvas.stroke}`
            : s.tool === "eraser"
              ? ui.canvas.eraserSize
              : s.tool === "pencil"
                ? `${ui.tools.pencil} ${ui.canvas.stroke}`
                : s.tool === "select"
                  ? `${ui.tools.select} ${ui.canvas.stroke}`
                  : ui.canvas.stroke;
      }
    },
  });

  pad.init();

  // Size preset button clicks
  document.querySelectorAll<HTMLButtonElement>(".size-preset-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const curTool = getActiveToolName();
      const presets = sizePresets[curTool] ?? sizePresets.brush;
      const presetKey = btn.dataset.preset as "small" | "medium" | "large" | "xlarge";
      if (presetKey && presets[presetKey]) {
        pad.setSize(presets[presetKey]);
        updateActiveSizePreset();
      }
    });
  });

  const sizeSlider = document.getElementById("size-slider") as HTMLInputElement;
  sizeSlider?.addEventListener("input", () => {
    updateActiveSizePreset();
  });

  // Stamp selection
  const stampButtons = document.querySelectorAll<HTMLButtonElement>("#stamps .stamp-btn");
  if (stampButtons.length) {
    stampButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const char = btn.dataset.char ?? "⭐";
        pad.setStamp(char);
        const stampBtn = toolButtons.stamp;
        if (stampBtn) stampBtn.click();
        stampButtons.forEach((b) => b.classList.toggle("is-active", b === btn));
        btn.setAttribute("aria-pressed", "true");
        updateActiveSizePreset();
      });
    });
  }

  // Magic Rainbow button
  const rainbowBtn = document.getElementById("rainbow-swatch");
  rainbowBtn?.addEventListener("click", () => {
    pad.setColor("rainbow");
    document.querySelectorAll(".swatch").forEach((s) => s.classList.remove("is-active"));
    rainbowBtn.classList.add("is-active");
  });

  document.querySelectorAll(".swatch").forEach((s) => {
    s.addEventListener("click", () => {
      rainbowBtn?.classList.remove("is-active");
    });
  });

  const colorInput = document.getElementById("color-input") as HTMLInputElement;
  colorInput?.addEventListener("input", () => {
    rainbowBtn?.classList.remove("is-active");
  });

  // Select all button
  const selectAllBtn = document.getElementById("select-all-btn");
  selectAllBtn?.addEventListener("click", () => {
    pad.selectAll();
  });

  // Paper themes
  const paperBtns = document.querySelectorAll<HTMLButtonElement>(".paper-btn");
  paperBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const color = btn.dataset.paperBg ?? "#ffffff";
      pad.setCanvasBgColor(color);
      paperBtns.forEach((b) => b.classList.toggle("is-active", b === btn));
    });
  });

  initCollabUI(pad, currentLocale);
  initThemeToggle(pad);
</script>