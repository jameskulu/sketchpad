---
import Prose from "./Prose.astro";
import { TOOL_PAGE_KEYS, type ToolPageContent, type ToolPageKey } from "../i18n/tool-content-types";
import { deriveLocaleHref, DEFAULT_LOCALE, type Locale } from "../i18n/locales";
import { uiFor } from "../i18n/ui";
import { headingIds } from "../lib/anchors";

interface Props {
  locale: Locale;
  pageKey: ToolPageKey;
  content: ToolPageContent;
}

const { locale, pageKey, content } = Astro.props;
const ui = uiFor(locale);

const ROUTES: Record<ToolPageKey, string> = {
  "drawing-board": "/drawing-board",
  whiteboard: "/whiteboard",
  "graph-paper": "/graph-paper",
  "kids-drawing": "/kids-drawing",
};

const related = TOOL_PAGE_KEYS.map((key) => {
  const info = content.related[key];
  return {
    key,
    href: deriveLocaleHref(locale, ROUTES[key]),
    label: info.label,
    blurb: info.blurb,
    current: key === pageKey,
  };
});

const homeHref = deriveLocaleHref(locale, "/");

const allHeadings = [...content.sections.map((section) => section.heading), content.faqHeading];
const ids = headingIds(allHeadings);
const sectionIds = ids.slice(0, content.sections.length);
const faqId = ids[ids.length - 1];
const toc = allHeadings.map((heading, index) => ({ id: ids[index], heading }));

const h2 = "mt-12 scroll-mt-24 text-xl font-semibold tracking-tight text-ink";
const p = "mt-4 text-[16px] leading-8 text-ink-secondary";
const faqQ = "text-[16px] font-semibold text-ink";
const faqA = "mt-2 text-[15px] leading-7 text-ink-secondary";
---

<section class="border-t border-hairline bg-white" aria-label={content.h1}>
  <div class="mx-auto w-full max-w-3xl px-4 py-14 sm:px-6 sm:py-20">
    <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">{content.h1}</h1>

    {content.intro.map((para) => (
      <p class="mt-6 text-[17px] leading-8 text-ink-secondary"><Prose text={para} /></p>
    ))}

    {locale === DEFAULT_LOCALE && toc.length >= 5 && (
      <nav class="mt-10 rounded-xl border border-hairline bg-canvas-soft p-5" aria-label="On this page">
        <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-ink-mute">On this page</p>
        <ol class="mt-3 grid gap-x-6 gap-y-1.5 sm:grid-cols-2">
          {toc.map((item) => (
            <li>
              <a
                href={`#${item.id}`}
                class="text-[14px] leading-6 text-ink-secondary transition-colors hover:text-primary"
              >
                {item.heading}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    {content.sections.map((sec, index) => (
      <>
        <h2 id={sectionIds[index]} class={h2}>{sec.heading}</h2>
        {sec.paragraphs.map((par) => (
          <p class:list={[p, "p"]}><Prose text={par} /></p>
        ))}
        {sec.list && (
          sec.ordered ? (
            <ol class="mt-4 list-decimal space-y-1.5 pl-5 text-[15px] leading-7 text-ink-secondary">
              {sec.list.map((li) => <li>{li}</li>)}
            </ol>
          ) : (
            <ul class="mt-4 list-disc space-y-1.5 pl-5 text-[15px] leading-7 text-ink-secondary">
              {sec.list.map((li) => <li>{li}</li>)}
            </ul>
          )
        )}
      </>
    ))}

    <h2 class={h2}>{content.relatedHeading}</h2>
    <div class="mt-4 grid gap-3 sm:grid-cols-2">
      {related.map((r) => (
        <a
          href={r.href}
          class:list={[
            "group block rounded-xl border bg-white p-4 transition-colors hover:shadow-md",
            r.current ? "border-primary/40 hover:border-primary/60" : "border-hairline hover:border-primary/40",
          ]}
        >
          <span class="block font-semibold text-ink">{r.label}</span>
          <span class="mt-1 block text-[13px] leading-6 text-ink-mute">{r.blurb}</span>
          <span class="mt-2 block text-[13px] font-medium text-primary">
            {ui.siteName} →
          </span>
        </a>
      ))}
    </div>

    <h2 id={faqId} class={h2}>{content.faqHeading}</h2>
    <div class="mt-4 divide-y divide-hairline">
      {content.faq.map((item) => (
        <div class="py-4">
          <h3 class={faqQ}>{item.q}</h3>
          <p class={faqA}><Prose text={item.a} /></p>
        </div>
      ))}
    </div>

    {content.closing.map((para) => (
      <p class="mt-10 text-[16px] leading-8 text-ink-secondary"><Prose text={para} /></p>
    ))}

    <p class="mt-10 text-[13px] text-ink-mute">
      <a
        href={homeHref}
        class="font-medium text-primary underline decoration-primary/30 underline-offset-2 hover:decoration-primary"
      >
        {ui.siteName}
      </a>
    </p>
  </div>
</section>