---
import Layout from "../layouts/Layout.astro";
import LangSwitcher from "./LangSwitcher.astro";
import { SITE } from "../lib/site";
import { uiFor } from "../i18n/ui";
import { toolUiFor } from "../i18n/tool-ui";
import { TOOL_DISPLAY_ORDER, TOOL_ROUTES } from "../i18n/tool-content-types";
import { deriveLocaleHref, type Locale } from "../i18n/locales";

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  locale: Locale;
  /** current route path (e.g. "/about") for localized links + hreflang */
  route: string;
  structuredData?: object | object[];
  /** Set false for pages that only exist in the default locale. */
  localized?: boolean;
  showLangSwitcher?: boolean;
  ogType?: string;
}

const {
  title,
  description,
  keywords,
  locale,
  route,
  structuredData,
  localized = true,
  showLangSwitcher = true,
  ogType,
} = Astro.props;

const ui = uiFor(locale);
const toolUi = toolUiFor(locale);

const rawLinks = [
  { rawPath: "/blog", label: ui.nav.blog, localized: false },
  { rawPath: "/about", label: ui.nav.about, localized: true },
  { rawPath: "/contact", label: ui.nav.contact, localized: true },
  { rawPath: "/privacy", label: ui.nav.privacyPolicy, localized: true },
  { rawPath: "/terms", label: ui.nav.terms, localized: true },
];

const links = rawLinks.map((l) => ({
  ...l,
  href: l.localized ? deriveLocaleHref(locale, l.rawPath) : `${l.rawPath}/`,
}));

const homeHref = deriveLocaleHref(locale, "/");
const openHref = deriveLocaleHref(locale, "/");

const creativeSpaces = [
  { href: deriveLocaleHref(locale, "/"), label: ui.siteName, dotColor: "#6746df" },
  ...TOOL_DISPLAY_ORDER.map((key) => ({
    href: deriveLocaleHref(locale, TOOL_ROUTES[key]),
    label: toolUi.boardNav.short[key],
    dotColor:
      key === "drawing-board"
        ? "#b66a20"
        : key === "whiteboard"
          ? "#187f72"
          : key === "graph-paper"
            ? "#3478bd"
            : "#ce598b",
  })),
  { href: "/storyboard/", label: "Storyboard", dotColor: "#6a69b5" },
];

const normRoute = route.replace(/\/$/, "");
const isCurrent = (rawPath: string) => {
  return normRoute === rawPath || (rawPath !== "" && normRoute.startsWith(rawPath));
};
---

<Layout
  title={`${title} — Simple Sketchpad`}
  description={description}
  keywords={keywords}
  locale={locale}
  route={route}
  structuredData={structuredData}
  alternates={localized}
  ogType={ogType}
>
  <div class="flex min-h-full flex-col">
    <header class="sticky top-0 z-40 flex h-14 shrink-0 items-center justify-between border-b border-hairline bg-white/95 dark:bg-[#121212]/95 px-4 backdrop-blur-md sm:px-6">
      <a href={homeHref} class="flex items-center gap-2 rounded-md px-1.5 py-1 transition-opacity hover:opacity-85" aria-label="Simple Sketchpad home">
        <svg width="22" height="22" viewBox="0 0 64 64" aria-hidden="true" class="shrink-0">
          <path d="M14 40c6-22 12-22 18-2s12 20 18-2" fill="none" stroke="#533afd" stroke-width="5" stroke-linecap="round" />
        </svg>
        <span class="text-sm font-semibold tracking-tight text-ink">{SITE.name}</span>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden md:flex items-center gap-1 lg:gap-2" aria-label="Site pages">
        {links.map((l) => {
          const active = isCurrent(l.rawPath);
          return (
            <a
              href={l.href}
              class:list={[
                "rounded-md px-2.5 py-1.5 text-[13px] font-medium transition-colors",
                active
                  ? "bg-canvas-soft font-semibold text-primary"
                  : "text-ink-mute hover:bg-canvas-soft hover:text-ink",
              ]}
              aria-current={active ? "page" : undefined}
            >
              {l.label}
            </a>
          );
        })}
        {showLangSwitcher && <LangSwitcher locale={locale} route={route} compact={true} />}
        <button
          id="theme-toggle-btn"
          type="button"
          class="theme-toggle-btn"
          aria-label="Toggle dark mode"
          title="Toggle dark mode"
        >
          <svg class="sun-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"/>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
          </svg>
          <svg class="moon-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
          </svg>
        </button>
        <a
          href={openHref}
          class="ml-1.5 inline-flex items-center gap-1.5 rounded-full bg-primary px-3.5 py-1.5 text-[13px] font-medium text-white shadow-xs transition-colors hover:bg-primary-deep"
        >
          {ui.footer.openSketchpad}
          <span aria-hidden="true">→</span>
        </a>
      </nav>

      <!-- Mobile Header Controls -->
      <div class="flex items-center gap-1.5 md:hidden">
        {showLangSwitcher && <LangSwitcher locale={locale} route={route} compact={true} />}
        <button
          id="theme-toggle-btn-mobile"
          type="button"
          class="theme-toggle-btn"
          aria-label="Toggle dark mode"
          title="Toggle dark mode"
        >
          <svg class="sun-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"/>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
          </svg>
          <svg class="moon-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
          </svg>
        </button>
        <button
          id="mobile-nav-toggle"
          type="button"
          class="flex size-9 items-center justify-center rounded-lg border border-hairline bg-white dark:bg-[#222222] text-ink transition-colors hover:bg-canvas-soft dark:hover:bg-[#2a2a2a] focus-visible:outline-2 focus-visible:outline-primary"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          aria-controls="mobile-nav-drawer"
        >
          <svg id="mobile-nav-hamburger" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="4" y1="7" x2="20" y2="7" />
            <line x1="4" y1="12" x2="20" y2="12" />
            <line x1="4" y1="17" x2="20" y2="17" />
          </svg>
          <svg id="mobile-nav-close" class="hidden size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18" />
            <line x1="6" y1="6" x2="18" y2="18" />
          </svg>
        </button>
      </div>
    </header>

    <!-- Mobile Drawer Backdrop -->
    <div
      id="mobile-nav-backdrop"
      class="fixed inset-0 top-14 z-30 hidden bg-slate-900/40 backdrop-blur-xs transition-opacity duration-200 md:hidden"
      aria-hidden="true"
    ></div>

    <!-- Mobile Navigation Drawer -->
    <div
      id="mobile-nav-drawer"
      class="fixed inset-x-0 top-14 z-40 max-h-[calc(100dvh-56px)] hidden flex-col overflow-y-auto overscroll-contain border-b border-hairline bg-white dark:bg-[#181818] px-4 py-5 shadow-2xl md:hidden"
      role="dialog"
      aria-modal="true"
      aria-label="Site navigation"
    >
      <!-- Primary Action CTA -->
      <a
        href={openHref}
        class="flex w-full items-center justify-center gap-2 rounded-xl bg-primary px-4 py-3 text-[14px] font-semibold text-white shadow-sm transition-colors hover:bg-primary-deep"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 20h9M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" />
        </svg>
        <span>{ui.footer.openSketchpad}</span>
        <span aria-hidden="true">→</span>
      </a>

      <!-- Site Pages Navigation -->
      <div class="mt-4 border-t border-hairline pt-3">
        <p class="px-2 text-[11px] font-semibold uppercase tracking-wider text-ink-mute">Pages</p>
        <nav class="mt-2 flex flex-col gap-1" aria-label="Mobile site pages">
          {links.map((l) => {
            const active = isCurrent(l.rawPath);
            return (
              <a
                href={l.href}
                class:list={[
                  "flex items-center justify-between rounded-lg px-3 py-2.5 text-[14px] font-medium transition-colors",
                  active
                    ? "bg-primary/10 font-semibold text-primary"
                    : "text-ink hover:bg-canvas-soft hover:text-primary",
                ]}
                aria-current={active ? "page" : undefined}
              >
                <span>{l.label}</span>
                <span class:list={["text-xs", active ? "font-bold text-primary" : "text-ink-mute"]} aria-hidden="true">→</span>
              </a>
            );
          })}
        </nav>
      </div>

      <!-- Creative Spaces Quick Links -->
      <div class="mt-4 border-t border-hairline pt-3">
        <p class="px-2 text-[11px] font-semibold uppercase tracking-wider text-ink-mute">{ui.canvas.drawingTools}</p>
        <div class="mt-2 grid grid-cols-2 gap-2">
          {creativeSpaces.map((tool) => (
            <a
              href={tool.href}
              class="flex items-center gap-2 rounded-lg border border-hairline bg-canvas-soft/60 dark:bg-[#222222] px-3 py-2 text-[13px] font-medium text-ink transition-colors hover:border-primary/40 hover:bg-white dark:hover:bg-[#2a2a2a]"
            >
              <span class="size-2 shrink-0 rounded-full" style={`background-color:${tool.dotColor}`}></span>
              <span class="truncate">{tool.label}</span>
            </a>
          ))}
        </div>
      </div>
    </div>

    <main class="mx-auto w-full max-w-2xl flex-1 px-4 py-10 sm:px-6 sm:py-14">
      <slot />
    </main>
  </div>
</Layout>

<script>
  const toggle = document.getElementById("mobile-nav-toggle");
  const drawer = document.getElementById("mobile-nav-drawer");
  const backdrop = document.getElementById("mobile-nav-backdrop");
  const burger = document.getElementById("mobile-nav-hamburger");
  const close = document.getElementById("mobile-nav-close");

  let isOpen = false;

  function setOpen(open: boolean) {
    isOpen = open;
    if (!toggle || !drawer || !backdrop) return;
    toggle.setAttribute("aria-expanded", String(open));
    if (open) {
      drawer.classList.remove("hidden");
      drawer.classList.add("flex");
      backdrop.classList.remove("hidden");
      burger?.classList.add("hidden");
      close?.classList.remove("hidden");
      document.body.style.overflow = "hidden";
    } else {
      drawer.classList.add("hidden");
      drawer.classList.remove("flex");
      backdrop.classList.add("hidden");
      burger?.classList.remove("hidden");
      close?.classList.add("hidden");
      document.body.style.overflow = "";
    }
  }

  toggle?.addEventListener("click", () => setOpen(!isOpen));
  backdrop?.addEventListener("click", () => setOpen(false));

  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && isOpen) {
      setOpen(false);
      toggle?.focus();
    }
  });

  window.addEventListener("resize", () => {
    if (window.innerWidth >= 768 && isOpen) {
      setOpen(false);
    }
  });

  drawer?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setOpen(false));
  });

  function setupThemeToggle(btnId: string) {
    const btn = document.getElementById(btnId);
    if (!btn) return;
    const isDarkInitial = document.documentElement.classList.contains("dark");
    btn.setAttribute("aria-pressed", String(isDarkInitial));
    btn.setAttribute("title", isDarkInitial ? "Switch to light mode" : "Switch to dark mode");

    if ((btn as any).__bound) return;
    (btn as any).__bound = true;

    btn.addEventListener("click", () => {
      const isDark = document.documentElement.classList.contains("dark");
      const nextDark = !isDark;
      document.documentElement.classList.toggle("dark", nextDark);
      btn.setAttribute("aria-pressed", String(nextDark));
      btn.setAttribute("title", nextDark ? "Switch to light mode" : "Switch to dark mode");
      try {
        localStorage.setItem("sketchpad_theme", nextDark ? "dark" : "light");
      } catch {}

      window.dispatchEvent(new CustomEvent("sketchpad:themechange", { detail: { darkMode: nextDark } }));
    });
  }

  setupThemeToggle("theme-toggle-btn");
  setupThemeToggle("theme-toggle-btn-mobile");
  document.addEventListener("astro:page-load", () => {
    setupThemeToggle("theme-toggle-btn");
    setupThemeToggle("theme-toggle-btn-mobile");
  });
</script>
