---
import SiteShell from "./SiteShell.astro";
import { SITE } from "../lib/site";
import type { PageContent } from "../i18n/content-types";
import type { Locale } from "../i18n/locales";
import { deriveLocaleHref } from "../i18n/locales";

interface Props {
  section: "about" | "contact" | "privacy" | "terms";
  locale: Locale;
  content: PageContent;
}

const { section, locale, content } = Astro.props;
const route = `/${section}`;

const titleMap: Record<string, string> = {
  about: content.about.h1,
  contact: content.contact.h1,
  privacy: content.privacy.h1,
  terms: content.terms.h1,
};
const title = titleMap[section];

const privacyHref = deriveLocaleHref(locale, "/privacy");
const contactHref = deriveLocaleHref(locale, "/contact");

const linkCls = "font-medium text-primary underline decoration-primary/30 underline-offset-2 hover:decoration-primary";
const h2 = "mt-10 text-lg font-semibold text-ink";
const p = "mt-3 text-[15px] leading-7 text-ink-secondary";
const h1 = "text-2xl font-bold tracking-tight text-ink sm:text-3xl";
---

<SiteShell title={title} locale={locale} route={route}>
  {section === "about" && (
    <>
      <h1 class={h1}>{content.about.h1}</h1>
      {content.about.intro.map((para) => <p class:list={["mt-4", p]}>{para}</p>)}

      <h2 class={h2}>{content.about.whatHeading}</h2>
      <ul class="mt-3 space-y-2 text-[15px] leading-7 text-ink-secondary">
        {content.about.what.map((li) => <li>{li}</li>)}
      </ul>

      <h2 class={h2}>{content.about.privacyHeading}</h2>
      {content.about.privacy.map((para) => (
        <p class={p}>
          {para}{" "}
          <a href={privacyHref} class={linkCls}>{content.privacy.h1}</a>.
        </p>
      ))}

      <h2 class={h2}>{content.about.contactHeading}</h2>
      {content.about.contact.map((para) => (
        <p class={p}>
          {para}{" "}
          <a href={contactHref} class={linkCls}>{content.contact.h1}</a>.
        </p>
      ))}
    </>
  )}

  {section === "contact" && (
    <>
      <h1 class={h1}>{content.contact.h1}</h1>
      {content.contact.intro.map((para) => <p class:list={["mt-4", p]}>{para}</p>)}

      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        <a href={`mailto:${SITE.email}`} class="group block rounded-xl border border-hairline bg-white p-5 transition-colors hover:border-primary/40 hover:shadow-md">
          <span class="flex size-10 items-center justify-center rounded-lg bg-canvas-soft text-primary">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path d="m3.5 7 8.5 6 8.5-6" />
            </svg>
          </span>
          <span class="mt-4 block font-semibold text-ink">{content.contact.emailTitle}</span>
          <span class="mt-1 block text-[13px] leading-6 text-ink-mute">{content.contact.emailDesc}</span>
          <span class="mt-3 block text-[13px] font-medium text-primary">{SITE.email}</span>
        </a>

        <a href={SITE.github} target="_blank" rel="noopener" class="group block rounded-xl border border-hairline bg-white p-5 transition-colors hover:border-primary/40 hover:shadow-md">
          <span class="flex size-10 items-center justify-center rounded-lg bg-canvas-soft text-primary">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.56 9.56 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85V21c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" />
            </svg>
          </span>
          <span class="mt-4 block font-semibold text-ink">{content.contact.githubTitle}</span>
          <span class="mt-1 block text-[13px] leading-6 text-ink-mute">{content.contact.githubDesc}</span>
          <span class="mt-3 block text-[13px] font-medium text-primary">GitHub</span>
        </a>
      </div>
    </>
  )}

  {section === "privacy" && (
    <>
      <h1 class={h1}>{content.privacy.h1}</h1>
      <p class={p}>{content.privacy.updated}</p>

      <h2 class={h2}>{content.privacy.shortHeading}</h2>
      {content.privacy.short.map((para) => <p class={p}>{para}</p>)}

      <h2 class={h2}>{content.privacy.storeHeading}</h2>
      {content.privacy.store.map((para) => <p class={p}>{para}</p>)}
      <ul class="mt-3 list-disc space-y-2 pl-5 text-[15px] leading-7 text-ink-secondary">
        {content.privacy.storeList.map((li) => <li>{li}</li>)}
      </ul>

      <h2 class={h2}>{content.privacy.notHeading}</h2>
      <ul class="mt-3 list-disc space-y-2 pl-5 text-[15px] leading-7 text-ink-secondary">
        {content.privacy.notList.map((li) => <li>{li}</li>)}
      </ul>

      <h2 class={h2}>{content.privacy.cookiesHeading}</h2>
      {content.privacy.cookies.map((para) => <p class={p}>{para}</p>)}

      <h2 class={h2}>{content.privacy.changesHeading}</h2>
      {content.privacy.changes.map((para) => <p class={p}>{para}</p>)}

      <h2 class={h2}>{content.privacy.contactHeading}</h2>
      <p class={p}>
        {content.privacy.contact}{" "}
        <a href={`mailto:${SITE.email}`} class={linkCls}>{SITE.email}</a>.
      </p>
    </>
  )}

  {section === "terms" && (
    <>
      <h1 class={h1}>{content.terms.h1}</h1>
      <p class={p}>{content.terms.updated}</p>

      {content.terms.sections.map((sec) => (
        <div>
          <h2 class={h2}>{sec.title}</h2>
          {sec.body.map((para) => <p class={p}>{para}</p>)}
        </div>
      ))}
    </>
  )}
</SiteShell>
