---
import Layout from "../layouts/Layout.astro";
import { SITE } from "../lib/site";
---

<Layout
  title="404 — Page Not Found | Simple Sketchpad"
  description="This page could not be found. Head back to the online sketchpad and keep drawing."
  robots="noindex, nofollow"
>
  <div class="flex min-h-full flex-col bg-canvas-soft">
    <header class="flex h-14 shrink-0 items-center border-b border-hairline bg-white/95 px-4 sm:px-6">
      <a href="/" class="flex items-center gap-2 rounded-md px-1.5 py-1" aria-label="Back to the sketchpad">
        <svg width="22" height="22" viewBox="0 0 64 64" aria-hidden="true">
          <path d="M14 40c6-22 12-22 18-2s12 20 18-2" fill="none" stroke="#533afd" stroke-width="5" stroke-linecap="round" />
        </svg>
        <span class="text-sm font-semibold tracking-tight text-ink">{SITE.name}</span>
      </a>
    </header>

    <main class="mx-auto flex w-full max-w-xl flex-1 flex-col items-center justify-center px-4 py-16 text-center">
      <p class="eyebrow text-primary">Error 404</p>
      <h1 class="mt-4 text-5xl font-bold tracking-tight text-ink sm:text-6xl">This page is blank</h1>
      <p class="mt-4 text-[16px] leading-7 text-ink-secondary">
        The page you&rsquo;re looking for doesn&rsquo;t exist — or it has moved. Your sketchpad is still
        here, ready when you are.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href="/" class="rounded-full bg-primary px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-primary-deep">Back to the sketchpad</a>
        <a href="/about" class="rounded-full border border-hairline bg-white px-5 py-2.5 text-sm font-medium text-ink-secondary transition-colors hover:bg-canvas-soft hover:text-ink">Learn more</a>
        <a href="/contact" class="text-sm font-medium text-primary underline decoration-primary/30 underline-offset-2 transition-colors hover:decoration-primary">Contact support</a>
      </div>
    </main>
  </div>
</Layout>

<style>
  @reference "../styles/global.css";

  .eyebrow {
    @apply text-[11px] font-semibold uppercase tracking-[0.14em];
  }
</style>