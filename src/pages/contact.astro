---
import SiteShell from "../components/SiteShell.astro";
import { SITE } from "../lib/site";
---

<SiteShell title="Contact Us" description="How to reach the people behind Simple Sketchpad.">
  <h1 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">Contact Us</h1>
  <p class="mt-4 text-[15px] leading-7 text-ink-secondary">
    Have a question, found a bug, or have an idea for Simple Sketchpad? We would love to hear from you.
  </p>

  <div class="mt-8 grid gap-4 sm:grid-cols-2">
    <a
      href={`mailto:${SITE.email}`}
      class="group block rounded-xl border border-hairline bg-white p-5 transition-colors hover:border-primary/40 hover:shadow-md"
    >
      <span class="flex size-10 items-center justify-center rounded-lg bg-canvas-soft text-primary">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="5" width="18" height="14" rx="2" />
          <path d="m3.5 7 8.5 6 8.5-6" />
        </svg>
      </span>
      <span class="mt-4 block font-semibold text-ink">Email us</span>
      <span class="mt-1 block text-[13px] leading-6 text-ink-mute">For support and feedback. We reply as soon as we can.</span>
      <span class="mt-3 block text-[13px] font-medium text-primary">{SITE.email}</span>
    </a>

  </div>
</SiteShell>